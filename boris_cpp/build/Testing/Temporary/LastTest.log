    "origin = boris.Vec3(1.0, 2.0, 7.0)\n",
    "extent = boris.Vec3(4.0, 6.0, 0.0)\n",
    "grid = boris.PeriodicGrid(origin, extent, (4, 3, 8))\n",
    "assert (grid.origin.x, grid.origin.y, grid.origin.z) == (1.0, 2.0, 7.0)\n",
