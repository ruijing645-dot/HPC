    "# 2D 网格只有一个 z 平面，总节点数是 4 * 3。\n",
    "assert tuple(grid.cells) == (4, 3, 1)\n",
    "assert grid.size() == 12\n",
    "\n",
    "# x 方向间距是 4/4=1，y 方向间距是 6/3=2；z 没有网格间距。\n",
    "dx = grid.spacing()\n",
    "assert (dx.x, dx.y, dx.z) == (1.0, 2.0, 0.0)\n",
